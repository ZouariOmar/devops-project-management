# ==================================================================================
# .FILE
#   .env.example
#
# .SYNOPSIS
#   Example environment variables
#
# .DESCRIPTION
#   Copied to `project/.env` by Make if that file is missing.
#   Change every password before use. Never commit `project/.env`.
#
# .USAGE
#   cp project/.env.example project/.env
#
# .PARAMETER
#   N/A
#
# .INPUTS
#   None.
#
# .OUTPUTS
#   Environment variables for `make`.
#
# .NOTES
#   Version       : 1.0
#   Author        : @ZouariOmar (zouariomar20@gmail.com)
#   Created       : 2026-11-24
#   Changelog     : e1e38b7
# ==================================================================================

# --- LXC ---
CONTAINER_USER_PASSWORD=containerPassword123!
JENKINS_ADMIN_PASSWORD=jenkinsPassword123!

# --- Monitoring ---
GRAFANA_ADMIN_PASSWORD=grafanaPassword123!

# --- Database ---
MYSQL_ROOT_PASSWORD=rootPassword123!
MYSQL_DATABASE=auto-loc
MYSQL_USER=user
MYSQL_PASSWORD=userPassword123!
MYSQL_PORT=30306
