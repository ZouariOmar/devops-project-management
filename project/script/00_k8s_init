#!/usr/bin/env bash
set -Eeuo pipefail
trap 'msg ERROR "Unexpected error at line $LINENO: $BASH_COMMAND"' ERR

LIB_DIR=project/script/lib
K8S_MONITORING_NAMESPACE=monitoring
K8S_GRAFANA_PORT=3000

main() {
  check_requirements kubectl helm k3s

  # === Prometheus ===
  msg INFO "Configure Prometheus"

  # Add prometheus helm repository
  # Source: https://artifacthub.io/packages/helm/prometheus-community/prometheus
  helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
  helm repo update

  # Create `monitoring` namespace
  kubectl create namespace "${K8S_MONITORING_NAMESPACE}"

  # deploy prometheus into `monitoring`
  helm install prometheus prometheus-community/prometheus -n "${K8S_MONITORING_NAMESPACE}"

  # === Grafana ===
  msg INFO "Configure Grafana"

  # Add grafana helm repository
  # Source: https://artifacthub.io/packages/helm/grafana-community/grafana
  helm repo add grafana-community https://grafana.github.io/helm-charts
  helm repo update

  # deploy grafana into `monitoring`
  helm install grafana grafana-community/grafana -n "${K8S_MONITORING_NAMESPACE}"

  # Retrieve the complete list of kubernetes services
  kubectl get service ${K8S_MONITORING_NAMESPACE}

  # Exposing the grafana kubernetes service
  kubectl expose service grafana \
    --type=NodePort \
    --target-port=${K8S_GRAFANA_PORT} \
    --name=grafana-ext \
    -n ${K8S_MONITORING_NAMESPACE}
}

# ---------------------------------------------------------------------------
# Bootstrap
# ---------------------------------------------------------------------------
if [[ -s "${LIB_DIR}/common" ]]; then
  # shellcheck disable=SC1091
  . "${LIB_DIR}/common"
else
  echo "[ERROR] Missing: ${LIB_DIR}/common" >&2
  exit 1
fi
load_script "${LIB_DIR}/logger"
load_script "${LIB_DIR}/requirement"

# Source: https://patorjk.com/software/taag/#p=display&f=ANSI+Shadow&t=k8s+init&x=none&v=4&h=4&w=80&we=false
cat <<'BANNER'
██╗  ██╗ █████╗ ███████╗    ██╗███╗   ██╗██╗████████╗
██║ ██╔╝██╔══██╗██╔════╝    ██║████╗  ██║██║╚══██╔══╝
█████╔╝ ╚█████╔╝███████╗    ██║██╔██╗ ██║██║   ██║
██╔═██╗ ██╔══██╗╚════██║    ██║██║╚██╗██║██║   ██║
██║  ██╗╚█████╔╝███████║    ██║██║ ╚████║██║   ██║
╚═╝  ╚═╝ ╚════╝ ╚══════╝    ╚═╝╚═╝  ╚═══╝╚═╝   ╚═╝
BANNER

main
